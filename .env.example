NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase project URL and publishable key. Leave blank for the local demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase Shared Transaction Pooler URL (port 6543) for Vercel/serverless.
DATABASE_URL=
# Use pool size 1 for serverless instances using the transaction pooler.
DATABASE_POOL_MAX=1
# Production schema changes are applied once from db/schema.sql, not on cold starts.
DATABASE_AUTO_SCHEMA=false
# Local development uses durable PGlite under .data when DATABASE_URL is empty.
# Required for signed organizer and protected-attendee cookies in production.
SESSION_SECRET=
# Organizer login secret. Keep separate from SESSION_SECRET.
ADMIN_SECRET=
# Turnstile public site key; set its matching secret in Supabase Auth CAPTCHA settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Matching Turnstile secret for server-side validation on ticket-join/invitation claims.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
# Set true only behind Cloudflare, with the origin restricted to Cloudflare IPs.
TRUST_CLOUDFLARE_HEADERS=false
# Alternative: trust x-real-ip only when your host overwrites it for every request.
TRUST_PLATFORM_REAL_IP=false
# Keep demo-account sign-in off in production. Enable only for isolated demos.
ALLOW_DEMO_AUTH=false
# Optional shared-secret endpoint for an external scheduler to progress sales.
CRON_SECRET=
